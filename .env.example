# העתיקו קובץ זה ל-.env.local (פיתוח מקומי) או הגדירו כמשתני סביבה ב-Hostinger
# Node.js Web App (Environment Variables) בפרודקשן. לעולם אל תעלו .env.local ל-git.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mishna_top
DB_USER=mishna
DB_PASSWORD=CHANGE_ME

# מפתח סודי לחתימת עוגיית הסשן (iron-session) — מחרוזת אקראית של 32+ תווים.
# ליצירה: openssl rand -base64 32
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

APP_URL=http://localhost:3000

# WhatsApp Cloud API של Meta — ריק = תזכורות WhatsApp כבויות בשקט. ראו README.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_TEMPLATE_NAME=daily_reminder
WHATSAPP_TEMPLATE_LANG=he

# SMTP לשליחת מיילים (ריק = מיילים כבויים בשקט). לדוגמה חשבון מייל שסופק ע"י הוסטינגר.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="משנה של נשמה <no-reply@mishna.top>"

# סוד לאימות קריאות ל-/api/cron/send-reminders (Hostinger Cron Jobs -> curl עם header זה).
CRON_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_STRING
